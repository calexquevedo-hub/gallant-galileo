---
import { ArrowRight } from 'lucide-react';
import { firstSession } from '../data/site';

const firstSessionSteps = [
  'Conhecer o motivo que trouxe você até aqui.',
  'Explicar como trabalho e responder às suas dúvidas.',
  'Combinar os próximos passos do acompanhamento.'
];
---
<section id="primeiro-encontro" class="section reveal-on-scroll first-session-section">
  <div class="container first-session-layout">
    <div class="first-session-copy">
      <span class="eyebrow eyebrow-sage">Primeiro encontro</span>
      <h2>Como <em class="heading-accent">começamos?</em></h2>
      {firstSession.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <ol class="first-session-steps">
      {firstSessionSteps.map((step, index) => (
        <li><span>{String(index + 1).padStart(2, '0')}</span><strong>{step}</strong></li>
      ))}
    </ol>
  </div>
  <div class="container first-session-footer-link">
    <button type="button" class="btn btn-primary first-session-cta" data-open-first-contact>
      Agendar o primeiro encontro <ArrowRight size={18} aria-hidden="true" />
    </button>
  </div>
</section>

<script>
  document.querySelectorAll('[data-open-first-contact]').forEach((element) => {
    element.addEventListener('click', () => window.dispatchEvent(new Event('open-first-contact')));
  });
</script>
