---
import { AtSign, Music2 } from 'lucide-react';
import { site, socialLinks } from '../data/site';
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-column footer-identity">
        <div class="brand footer-brand">
          <img src="/images/logo-tree-white.png" alt="" width="42" height="42" loading="lazy" />
          <span class="brand-copy">
            <span class="brand-name">{site.name}</span>
            <span class="brand-registration">{site.profession}</span>
          </span>
        </div>
        <p class="footer-credentials"><strong>{site.fullName}</strong><br />{site.profession} · {site.crp}</p>
      </div>

      <div class="footer-column footer-hours">
        <h3>Atendimento</h3>
        <p>Online para todo o Brasil<br />Presencial em Fortaleza<br />Segunda a sábado, com hora marcada</p>
      </div>

      <div class="footer-column footer-connect">
        <h3>Conecte-se</h3>
        <div class="footer-social-links">
          {socialLinks.map(({ label, href }) => (
            <a href={href} target="_blank" rel="noopener noreferrer" aria-label={`${label} de ${site.name}`}>
              {label === 'Instagram' ? <AtSign size={18} strokeWidth={1.8} aria-hidden="true" /> : <Music2 size={18} strokeWidth={1.8} aria-hidden="true" />}
              <span>{label}</span>
            </a>
          ))}
        </div>

        <div class="footer-cronoshare">
          <span class="footer-cronoshare-label">Perfil profissional</span>
          <a
            href="https://www.cronoshare.com.br/croner-3885506-alexandre-quevedo"
            target="_blank"
            rel="noopener noreferrer"
            title="Veja o perfil profissional de Alexandre Quevedo na Cronoshare"
            aria-label="Veja o perfil profissional de Alexandre Quevedo na Cronoshare"
            class="cronoWidget"
            style="width: 76px; height: 76px"
          >
            <svg viewBox="0 0 100 100" aria-hidden="true">
              <defs><path id="arc" d="M11 50 A 39 39 0 0 0 89 50"></path></defs>
              <circle cx="50%" cy="50%" r="50%" fill="#ffffff"></circle>
              <circle cx="50%" cy="50%" r="43%" stroke="#49abe8" stroke-width="1.2%" fill-opacity="0"></circle>
              <image width="80%" x="10%" y="35%" href="https://www.cronoshare.com.br/assets/badges/logo-normal-89ff9c34f6ff22b027fae7dbbc4c0c48.svg"></image>
              <image width="90%" x="5%" y="2%" href="https://www.cronoshare.com.br/assets/badges/favicon-blue-252f914684bd5b175f45e5e7a5a6c41e.svg"></image>
              <text text-anchor="middle" x="50%" y="60%" fill="#49abe8" font-family="Calibri" font-size="70%" font-weight="bold">PROFISSIONAL</text>
              <text fill="#49abe8" font-family="Calibri" font-size="70%" font-weight="bold" text-anchor="middle">
                <textPath href="#arc" startOffset="50%">DESDE 2025</textPath>
              </text>
            </svg>
          </a>
          <script
            is:inline
            id="cronoscript"
            src="https://www.cronoshare.com.br/assets/cronoSealWidget-ba977fd463539c4e3a5e7cec83eb3f99.js"
            type="text/javascript"
            domain="https://www.cronoshare.com.br"
            csspath="/assets/cronoSealWidget-c1a93f6d3bd9edeb8fc8ba80fcc1be00.css"
            defer
          ></script>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-meta">
        <span>© {new Date().getFullYear()} {site.fullName} · {site.crp}</span>
        <slot name="privacy" />
      </div>
      <p class="footer-emergency">
        Este site não oferece atendimento emergencial. Em situações de crise, procure o <a href="tel:192">SAMU (192)</a>, o <a href="tel:188">CVV (188)</a> ou o pronto atendimento mais próximo.
      </p>
    </div>
  </div>
</footer>
