---
import '../index.css';
import { site, offices, socialLinks, topics } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Alexandre Quevedo | Psicólogo em Fortaleza',
  description = 'Carlos Alexandre Quevedo, psicólogo em Fortaleza, CRP 11/24669. Psicoterapia presencial e online para adultos, casais, adolescentes e crianças.'
} = Astro.props;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.url}/#person`,
      name: site.fullName,
      alternateName: site.name,
      jobTitle: site.profession,
      description: 'Psicólogo, CRP 11/24669, com atuação presencial em Fortaleza e atendimento online.',
      image: `${site.url}/images/psicologo-2026.webp`,
      url: `${site.url}/#sobre`,
      telephone: `+${site.whatsappNumber}`,
      email: site.email,
      identifier: {
        '@type': 'PropertyValue',
        propertyID: 'CRP',
        value: site.crp
      },
      sameAs: socialLinks.map(({ href }) => href),
      knowsAbout: topics.map(({ title }) => title),
      worksFor: { '@id': `${site.url}/#practice` }
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${site.url}/#practice`,
      name: `${site.name} | ${site.profession}`,
      description,
      image: `${site.url}/images/compartilhamento.jpg`,
      logo: `${site.url}/images/logo-tree-blue-512.png`,
      url: `${site.url}/`,
      telephone: `+${site.whatsappNumber}`,
      email: site.email,
      employee: { '@id': `${site.url}/#person` },
      sameAs: socialLinks.map(({ href }) => href),
      areaServed: [
        { '@type': 'City', name: 'Fortaleza' },
        { '@type': 'Country', name: 'Brasil' }
      ],
      location: [
        {
          '@type': 'Place',
          name: 'Transcender Psicologia · Aldeota',
          address: {
            '@type': 'PostalAddress',
            streetAddress: 'Av. Dom Luís, 500, sala 818, 8º andar, Torre do Shopping Aldeota, Aldeota',
            addressLocality: 'Fortaleza',
            addressRegion: 'CE',
            postalCode: offices.aldeota.postalCode,
            addressCountry: 'BR'
          },
          hasMap: offices.aldeota.mapUrl,
          openingHoursSpecification: {
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
            opens: '18:00',
            closes: '21:00'
          }
        },
        {
          '@type': 'Place',
          name: 'MultiMais Clínica · Maraponga',
          address: {
            '@type': 'PostalAddress',
            streetAddress: 'Rua Luxemburgo, 148, sala 8, MultiMais Clínica, Maraponga',
            addressLocality: 'Fortaleza',
            addressRegion: 'CE',
            postalCode: offices.maraponga.postalCode,
            addressCountry: 'BR'
          },
          hasMap: offices.maraponga.mapUrl,
          openingHoursSpecification: {
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: 'Saturday',
            opens: '08:00',
            closes: '12:00'
          }
        }
      ]
    }
  ]
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href="/images/logo-tree-blue-512.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#1f3c88" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`${site.url}/`} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content={`${site.url}/`} />
    <meta property="og:site_name" content="Alexandre Quevedo | Psicólogo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${site.url}/images/compartilhamento.jpg`} />
    <meta property="og:image:alt" content="Carlos Alexandre Quevedo, psicólogo em Fortaleza, CRP 11/24669" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.url}/images/compartilhamento.jpg`} />
    <meta name="twitter:image:alt" content="Carlos Alexandre Quevedo, psicólogo em Fortaleza, CRP 11/24669" />

    <link rel="preload" href="/fonts/inter-variable-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/lora-variable-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>

    <!-- Metricool: acompanhamento de acessos do site -->
    <script is:inline>
      function loadScript(a) {
        var b = document.getElementsByTagName("head")[0],
          c = document.createElement("script");
        c.type = "text/javascript";
        c.src = "https://tracker.metricool.com/resources/be.js";
        c.onreadystatechange = a;
        c.onload = a;
        b.appendChild(c);
      }

      loadScript(function () {
        beTracker.t({ hash: "fcf7bf1199e74fcf2956e0c3a56b2d1b" });
      });
    </script>
  </head>
  <body>
    <slot />
    <noscript>
      <p>Este site funciona melhor com JavaScript habilitado. Você também pode entrar em contato pelo WhatsApp para iniciar uma conversa.</p>
    </noscript>
  </body>
</html>
